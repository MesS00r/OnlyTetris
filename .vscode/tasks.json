{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "shell",
            "command": "cmake --build build --clean-first",
            "group": "build",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Run OS in QEMU",
            "type": "shell",
            "command": "qemu-system-i386",
            "args": [
                "-drive",
                "format=raw,file=${workspaceFolder}/os_image/onl_tetris.img",
                "-d", "cpu,int,guest_errors",
                "-D", "${workspaceFolder}/build/qemu.log"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": "Compile Project",
            "presentation": {
                "reveal": "always",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
