cabal-version: 3.14
name:          HCompile
version:       0.1.0.0
build-type:    Simple

common warnings
    ghc-options: -Wall -Wno-unused-top-binds -Wno-unused-matches -Wno-type-defaults

library
    import:             warnings
    exposed-modules:    HCompile
    hs-source-dirs:     hcompile

    build-depends:      base ^>=4.20.2.0,
                        mtl,
                        directory,
                        filepath,
                        JuicyPixels,
                        bytestring,
                        vector

    default-extensions: FlexibleInstances
                        UndecidableInstances
                        LambdaCase

    default-language:   Haskell2010

executable tetrominoesGen
    import:             warnings
    other-modules:      Paths_HCompile
    main-is:            Tetrominoes.hs
    hs-source-dirs:     .

    build-depends:      base ^>=4.20.2.0,
                        filepath,
                        containers,
                        HCompile

    default-language:   Haskell2010